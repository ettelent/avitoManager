<Window x:Class="AccountManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Manager" Width="920" Height="560" MinWidth="720" MinHeight="420">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Браузерные профили" FontSize="24" FontWeight="SemiBold" />
            <Button Content="Создать профиль" Command="{Binding CreateCommand}" DockPanel.Dock="Right" />
        </DockPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="130" />
                <DataGridTextColumn Header="Последний запуск" Binding="{Binding LastLaunchedAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="170" />
                <DataGridTextColumn Header="Прокси" Binding="{Binding ProxyServer}" Width="180" />
                <DataGridTextColumn Header="Папка профиля" Binding="{Binding ProfilePath}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Запустить" Command="{Binding LaunchCommand}" />
                <Button Content="Закрыть" Command="{Binding CloseCommand}" />
                <Button Content="Прокси…" Command="{Binding ConfigureProxyCommand}" />
                <Button Content="Обновить" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
